{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "cjs",
    "sourceMap": false,
    "declaration": false,
    "noEmit": false
  },
  "include": [
    "lib/**/*.js",
    "WAProto/**/*.js"
  ],
  "exclude": [
    "cjs",
    "node_modules"
  ]
}
